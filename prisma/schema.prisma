// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  avatar        String?
  role          String    @default("customer")
  emailVerified DateTime?
  password      String?

  // OAuth Providers
  accounts      Account[]
  sessions      Session[]

  // Ad Campaign Tracking
  adSource      String?   // "facebook", "google", "instagram", "organic", "referral"
  adCampaignId  String?   // Campaign ID that brought this user
  adSetId       String?   // Ad set ID
  adId          String?   // Specific ad ID
  utmSource     String?   // UTM parameters for tracking
  utmMedium     String?
  utmCampaign   String?
  utmTerm       String?
  utmContent    String?
  firstVisitAt  DateTime? // When user first visited

  // Additional User Data
  dateOfBirth   DateTime?
  gender        String?
  preferences   Json?     // User preferences as JSON
  lastLoginAt   DateTime?
  loginCount    Int       @default(0)

  addresses     Address[]
  orders        Order[]
  wishlist      WishlistItem[]
  reviews       Review[]
  subscriptions Subscription[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String
  isDefault    Boolean @default(false)
  
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("addresses")
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  image        String?
  icon         String?
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]
  
  productCount Int        @default(0)
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("categories")
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String   @db.Text
  shortDescription  String?
  price             Decimal  @db.Decimal(10, 2)
  compareAtPrice    Decimal? @db.Decimal(10, 2)
  images            String[]
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  tags              String[]
  
  inStock           Boolean  @default(true)
  stockQuantity     Int      @default(0)
  
  // Specifications
  height            String?
  potSize           String?
  sunlight          String?
  water             String?
  difficulty        String?
  petFriendly       Boolean  @default(false)
  indoor            Boolean  @default(true)
  outdoor           Boolean  @default(false)
  airPurifying      Boolean  @default(false)
  flowering         Boolean  @default(false)
  fruitBearing      Boolean  @default(false)
  fastGrowing       Boolean  @default(false)
  medicinal         Boolean  @default(false)
  
  // Care Instructions
  careWater         String?
  careSunlight      String?
  careTemperature   String?
  careHumidity      String?
  careFertilizer    String?
  careRepotting     String?
  carePruning       String?
  
  rating            Decimal  @default(0) @db.Decimal(3, 2)
  reviewCount       Int      @default(0)
  
  isNew             Boolean  @default(false)
  isBestSeller      Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  
  orderItems        OrderItem[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("products")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]

  status          String      @default("pending")
  paymentStatus   String      @default("pending")

  shippingAddress Address     @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId String
  billingAddress  Address     @relation(fields: [billingAddressId], references: [id])
  billingAddressId  String

  subtotal        Decimal     @db.Decimal(10, 2)
  shipping        Decimal     @db.Decimal(10, 2) @default(0)
  tax             Decimal     @db.Decimal(10, 2) @default(0)
  discount        Decimal     @db.Decimal(10, 2) @default(0)
  total           Decimal     @db.Decimal(10, 2)

  paymentMethod   String?
  trackingNumber  String?
  estimatedDelivery DateTime?
  notes           String?

  // Ad Campaign Tracking
  campaignId      String?     // Campaign that led to this order
  adPlatform      String?     // "facebook", "google", "instagram", etc.
  adSetId         String?
  adId            String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  conversionValue Decimal?    @db.Decimal(10, 2) // For ROI calculation

  campaign        AdCampaign? @relation(fields: [campaignId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  userAvatar String?
  rating    Int
  title     String
  content   String   @db.Text
  images    String[]
  helpful   Int      @default(0)
  verified  Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.Text
  coverImage  String
  author      String
  authorAvatar String?
  category    String
  tags        String[]
  publishedAt DateTime?
  readingTime Int      @default(5)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String
  status            String   @default("active")
  startDate         DateTime @default(now())
  nextDeliveryDate  DateTime?
  deliveryFrequency String
  preferences       String[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("subscriptions")
}

model Coupon {
  id                  String   @id @default(cuid())
  code                String   @unique
  type                String
  value               Decimal  @db.Decimal(10, 2)
  minPurchase         Decimal? @db.Decimal(10, 2)
  maxDiscount         Decimal? @db.Decimal(10, 2)
  applicableCategories String[]
  applicableProducts  String[]
  usageLimit          Int?
  usedCount           Int      @default(0)
  validFrom           DateTime
  validUntil          DateTime
  isActive            Boolean  @default(true)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("coupons")
}

model AdCampaign {
  id              String   @id @default(cuid())
  name            String
  platform        String   // "facebook", "google", "instagram", etc.
  campaignId      String   @unique // Platform-specific campaign ID
  status          String   @default("active") // "active", "paused", "completed"
  budget          Decimal  @db.Decimal(10, 2)
  spent           Decimal  @db.Decimal(10, 2) @default(0)
  startDate       DateTime
  endDate         DateTime?

  // Tracking
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  conversions    Int      @default(0)
  conversionValue Decimal  @db.Decimal(10, 2) @default(0)

  targeting       Json?    // Targeting criteria as JSON
  creativeAssets  String[] // URLs to ad images/videos

  orders          Order[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ad_campaigns")
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String   @unique
  ipAddress   String?
  userAgent   String?
  referrer    String?

  // UTM Parameters
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Ad Tracking
  adSource    String?
  adCampaignId String?
  adSetId     String?
  adId        String?

  // Session Activity
  pageViews   Int      @default(0)
  timeSpent   Int      @default(0) // in seconds
  bounced    Boolean  @default(false)
  converted  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_sessions")
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String?
  eventType   String   // "page_view", "add_to_cart", "purchase", "signup", etc.
  eventName   String
  eventData   Json?    // Event-specific data
  value       Decimal? @db.Decimal(10, 2) // Monetary value if applicable

  // Ad Attribution
  campaignId  String?
  adPlatform String?

  createdAt   DateTime @default(now())

  @@map("analytics_events")
}
